[Unit]
Description=Moto G7 Play USB RNDIS gadget for headless SSH
DefaultDependencies=no
After=systemd-modules-load.service sys-kernel-config.mount
Wants=sys-kernel-config.mount
Before=network.target ssh.service channel-dhcp.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/channel-usb-gadget
RemainAfterExit=yes
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
