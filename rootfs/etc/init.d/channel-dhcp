#!/sbin/openrc-run

description="DHCP server for Moto G7 Play USB RNDIS link"
command="/usr/sbin/dnsmasq"
command_args="--keep-in-foreground --port=0 --no-resolv --no-hosts --interface=usb0 --bind-interfaces --dhcp-authoritative --dhcp-range=172.16.42.2,172.16.42.20,255.255.255.0,12h --dhcp-option=3 --dhcp-option=6"
command_args_foreground=""
supervisor=supervise-daemon
respawn_delay=2
respawn_max=0

depend() {
    need channel-usb-gadget
}
