#!/bin/sh
set -eu

CONF=/etc/wpa_supplicant/wpa_supplicant-channel.conf
WPA_PID=""
DHCP_PID=""

cleanup() {
    [ -z "$DHCP_PID" ] || kill "$DHCP_PID" 2>/dev/null || true
    [ -z "$WPA_PID" ] || kill "$WPA_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

echo "channel-wifi: waiting for $CONF"
while [ ! -s "$CONF" ]; do
    sleep 2
done

i=0
until grep -q '^network={' "$CONF" &&
      grep -q '^[[:space:]]*psk=' "$CONF" &&
      grep -q '^[[:space:]]*}$' "$CONF"; do
    i=$((i + 1))
    [ "$i" -lt 30 ] || {
        echo "channel-wifi: invalid or incomplete wpa_supplicant config" >&2
        exit 1
    }
    sleep 1
done

sed -i '/^[[:space:]]*#psk=/d' "$CONF"
chmod 0600 "$CONF"
mkdir -p /run/wpa_supplicant

/usr/local/sbin/channel-wifi-firmware
ip link set wlan0 up

WPA_SUPPLICANT="$(command -v wpa_supplicant || true)"
[ -n "$WPA_SUPPLICANT" ] && [ -x "$WPA_SUPPLICANT" ] || {
    echo "channel-wifi: wpa_supplicant binary not found" >&2
    exit 1
}

"$WPA_SUPPLICANT" -i wlan0 -D nl80211 -c "$CONF" &
WPA_PID=$!

/usr/local/sbin/channel-wifi-dhcp &
DHCP_PID=$!

while :; do
    if ! kill -0 "$WPA_PID" 2>/dev/null; then
        wait "$WPA_PID" || true
        echo "channel-wifi: wpa_supplicant exited" >&2
        exit 1
    fi
    if ! kill -0 "$DHCP_PID" 2>/dev/null; then
        rc=0
        wait "$DHCP_PID" || rc=$?
        exit "$rc"
    fi
    sleep 2
done
