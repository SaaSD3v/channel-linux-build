#!/bin/sh
set -eu

mask_to_prefix() {
    old_ifs="$IFS"
    IFS=.
    set -- $1
    IFS="$old_ifs"
    [ "$#" -eq 4 ] || return 1
    bits=0
    for octet in "$@"; do
        case "$octet" in
            255) n=8 ;;
            254) n=7 ;;
            252) n=6 ;;
            248) n=5 ;;
            240) n=4 ;;
            224) n=3 ;;
            192) n=2 ;;
            128) n=1 ;;
            0)   n=0 ;;
            *) return 1 ;;
        esac
        bits=$((bits + n))
    done
    printf '%s\n' "$bits"
}

case "${1:-}" in
    deconfig)
        ip -4 addr flush dev "$interface" scope global 2>/dev/null || true
        ip -4 route del default dev "$interface" 2>/dev/null || true
        ;;
    bound|renew)
        prefix=24
        if [ -n "${subnet:-}" ]; then
            prefix="$(mask_to_prefix "$subnet" 2>/dev/null || echo 24)"
        fi

        ip -4 addr flush dev "$interface" scope global
        ip -4 addr add "$ip/$prefix" dev "$interface"

        for gateway in ${router:-}; do
            ip -4 route replace default via "$gateway" dev "$interface"
            break
        done

        if [ -n "${dns:-}" ]; then
            : > /etc/resolv.conf
            for server in $dns; do
                printf 'nameserver %s\n' "$server" >> /etc/resolv.conf
            done
        fi
        ;;
esac
